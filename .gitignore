# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# IDE / editor metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# OS / runtime junk
*.log
*.pid
*.tmp
*.bak

# Jupyter notebook checkpoints (the committed notebooks themselves are kept)
.ipynb_checkpoints/

# Credentials and secrets — never commit
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Local-only diagnostic state
/local_state/
/tmp/
